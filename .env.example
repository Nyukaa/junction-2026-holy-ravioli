

# Anthropic
ANTHROPIC_API_KEY=

# Database: set to "fake" to use in-memory fixtures (no PostgreSQL needed),
# leave empty to use the real Aiven PostgreSQL implementation
DB_BACKEND=
DATABASE_URL=
# Trusted CA certificate: PEM contents or a local file path.
DATABASE_CA=

# Apply db/migrations/001_..., 002_..., then 003_... before using PostgreSQL tools.
# Actual transaction visibility is controlled by app.demo_clock.today.
# Confirmed plans include future dates; saving replaces the customer's whole plan.
